{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchmissioncontrol.local/schemas/error.schema.json",
  "title": "ErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "error"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_SCHEMA",
            "UNSUPPORTED_VERSION",
            "UNAUTHENTICATED",
            "UNAUTHORIZED",
            "NOT_FOUND",
            "STATE_CONFLICT",
            "STALE_LEASE",
            "STALE_EXECUTION_GENERATION",
            "IDEMPOTENCY_CONFLICT",
            "VERSION_CONFLICT",
            "BUDGET_EXHAUSTED",
            "RATE_LIMITED",
            "DEPENDENCY_UNAVAILABLE",
            "CLOUD_PERSISTENCE_FAILURE"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
