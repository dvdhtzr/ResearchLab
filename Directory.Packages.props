<Project>
  <!--
    Central package management. VERSIONS ARE PROVISIONAL and MUST be confirmed
    against current official sources on a machine with the .NET 10 SDK before the
    first restore (per spec §5: pin in lockfiles after the initial successful build).
    This file was authored without a dotnet SDK and has NOT been restored or built.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- AI abstraction + agent framework (confirm exact versions on Windows) -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="*" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="*" />
    <!-- Ollama adapter: OllamaSharp or a verified Microsoft.Extensions.AI-compatible client -->
    <PackageVersion Include="OllamaSharp" Version="*" />
    <!-- Hosting / worker service -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="*" />
    <!-- SQLite -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="*" />
    <!-- JSON Schema validation -->
    <PackageVersion Include="JsonSchema.Net" Version="*" />
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="*" />
    <PackageVersion Include="xunit" Version="*" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="*" />
  </ItemGroup>
</Project>
